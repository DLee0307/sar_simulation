      <collision name='Body_Collision_Battery'>
        <pose>2.88e-3 0 35.0e-3 0 0 0</pose>
        <geometry>
          <box>
            <size>80.0e-3 45.0e-3 70.0e-3 </size>
          </box>
        </geometry>
      </collision>
    </link>

    <link name='Prop_1'>
      <inertial>
        <mass>1e-6</mass>
        <inertia>
          <ixx>1e-9</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-9</iyy>
          <iyz>0</iyz>
          <izz>1e-9</izz>
