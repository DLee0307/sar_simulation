    <!-- Test pitch tracking without writing a custom C++ plugin. -->
    <plugin
      filename='gz-sim-joint-position-controller-system'
      name='gz::sim::systems::JointPositionController'>
      <joint_name>Camera_Pitch_Joint</joint_name>
      <topic>/SAR_Base/gimbal/pitch_cmd</topic>

      <!-- Use velocity commands instead of PID torque control -->
      <use_velocity_commands>true</use_velocity_commands>

      <!-- Maximum angular speed: 0.35 rad/s -->
      <cmd_max>1.0</cmd_max>
      <cmd_min>-1.0</cmd_min>

      <initial_position>0.0</initial_position>
    </plugin>

    <!-- Camera Pitch Joint State Publisher -->
    <plugin
      filename='gz-sim-joint-state-publisher-system'
      name='gz::sim::systems::JointStatePublisher'>

      <joint_name>Camera_Pitch_Joint</joint_name>
      <topic>/SAR_Base/gimbal/joint_state</topic>
      <update_rate>100</update_rate>

    </plugin>

    <static>0</static>
    <allow_auto_disable>1</allow_auto_disable>
  </model>
</sdf>
