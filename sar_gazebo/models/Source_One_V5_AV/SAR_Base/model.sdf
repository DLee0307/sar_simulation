    <!-- Active Vision Plugin -->
    <plugin
      filename="/home/dlee/ros2_ws/install/sar_gazebo/lib/libActive_Vision_Plugin.so"
      name="gz::sim::systems::Active_Vision_Plugin">

      <!-- Existing SDF entities -->
      <camera_link_name>Camera</camera_link_name>
      <camera_sensor_name>camera</camera_sensor_name>
      <pitch_joint_name>Camera_Pitch_Joint</pitch_joint_name>

      <!-- Gazebo Topics -->
      <camera_topic>/camera</camera_topic>
      <joint_state_topic>/SAR_Base/gimbal/joint_state</joint_state_topic>
      <pitch_command_topic>/SAR_Base/gimbal/pitch_cmd</pitch_command_topic>

      <!-- Operating mode -->
      <mode>search_track</mode>

      <!-- Active Vision processing -->
      <active_vision_rate_hz>10.0</active_vision_rate_hz>
      <target_tag_id>0</target_tag_id>

      <!-- Search settings -->
      <search_min_pitch_rad>0.0</search_min_pitch_rad>
      <search_max_pitch_rad>0.785398</search_max_pitch_rad>
      <search_period_sec>6.0</search_period_sec>

      <!-- Tracking -->
      <tracking_gain>0.65</tracking_gain>

      <!-- Marker loss and recovery -->
      <lost_timeout_sec>0.5</lost_timeout_sec>
      <reacquire_frames>2</reacquire_frames>

      <!-- Visualization -->
      <enable_debug_image>true</enable_debug_image>
      <debug_image_topic>/camera/active_vision</debug_image_topic>


      <!-- Display-only RGB8: fixed gamma -->
      <raw_display_topic>/camera/raw_rgb</raw_display_topic>
      <display_gamma>0.35</display_gamma>

    </plugin>

    <plugin
        filename="/home/dlee/ros2_ws/install/sar_gazebo/lib/libMotor_Plugin.so"
        name="gz::sim::systems::Motor_Plugin">
        <Motor_Number>1</Motor_Number>
        <joint_name>Prop_1_Joint</joint_name>
        <link_name>Prop_1</link_name>
        <canonicallink_name>SAR_Body</canonicallink_name>
        <Turning_Direction>ccw</Turning_Direction>
        <Visual_Slowdown>200</Visual_Slowdown>                
    </plugin>

    <plugin
        filename="/home/dlee/ros2_ws/install/sar_gazebo/lib/libMotor_Plugin.so"
